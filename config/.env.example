# =============================================================================
# FigsApp — variables d'environnement
# Copiez ce fichier vers config/.env pour le dev local :
#   copy config\.env.example config\.env
# =============================================================================

PORT=5000
NODE_ENV=development

# --- Neon PostgreSQL (obligatoire en prod Vercel) ---
# Dev local : copiez depuis Vercel → Storage → Neon → Connection string
# Prod Vercel : ajoutée automatiquement si Neon est connecté au projet
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# --- Auth admin ---
# Prod : utilisez une valeur longue et aléatoire (64+ caractères)
JWT_SECRET=dev_local_jwt_secret_min_32_chars_ok
JWT_EXPIRES_IN=12h
ADMIN_COOKIE_NAME=sa_admin

# --- CORS ---
# Dev local
CORS_ORIGIN=http://localhost:3001
# Prod (dans Vercel) :
# CORS_ORIGIN=https://figsappcotedivoire.com,https://www.figsappcotedivoire.com

JSON_BODY_LIMIT=200kb
UPLOAD_PATH=./api/uploads

# --- SQLite (optionnel, Windows + Node 20 + Build Tools) ---
# DB_DRIVER=sqlite
