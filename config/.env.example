PORT=5000
NODE_ENV=development

# --- Dev local avec Neon (recommandé, même base que Vercel) ---
# Copiez DATABASE_URL depuis Vercel → Storage → Neon
# DATABASE_URL=postgresql://...

# --- Dev local SQLite (Node 20.x requis, npm install better-sqlite3) ---
DB_DRIVER=sqlite

JWT_SECRET=dev_local_jwt_secret_min_32_chars_ok
JWT_EXPIRES_IN=12h
ADMIN_COOKIE_NAME=sa_admin
CORS_ORIGIN=http://localhost:3001
JSON_BODY_LIMIT=200kb
UPLOAD_PATH=./api/uploads
