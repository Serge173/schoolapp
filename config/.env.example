PORT=5000
NODE_ENV=development

# --- Neon (recommandé : même base que Vercel, fonctionne sur Node 20+) ---
# Copiez DATABASE_URL depuis Vercel → Storage → Neon → config/.env
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# --- SQLite (Node 20.x + Visual Studio Build Tools sur Windows) ---
# DB_DRIVER=sqlite

JWT_SECRET=dev_local_jwt_secret_min_32_chars_ok
JWT_EXPIRES_IN=12h
ADMIN_COOKIE_NAME=sa_admin
CORS_ORIGIN=http://localhost:3001
JSON_BODY_LIMIT=200kb
UPLOAD_PATH=./api/uploads
