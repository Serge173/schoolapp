# =============================================================================
# À coller dans Vercel → Project → Settings → Environment Variables
# Environments : cocher Production + Preview pour chaque variable
#
# Étape 1 : Vercel → Storage → Create Database → Neon → Connect to Project
#           (Custom Prefix VIDE) → DATABASE_URL est ajoutée automatiquement
# Étape 2 : Ajoutez les variables ci-dessous MANUELLEMENT
# Étape 3 : Supprimez VITE_API_BASE, DB_HOST, DB_USER, DB_PASSWORD, DB_NAME si présents
# =============================================================================

NODE_ENV=production
JWT_SECRET=REMPLACER_PAR_UNE_CLE_ALEATOIRE_64_CARACTERES_MINIMUM
JWT_EXPIRES_IN=12h
ADMIN_COOKIE_NAME=sa_admin
CORS_ORIGIN=https://figsappcotedivoire.com,https://www.figsappcotedivoire.com
JSON_BODY_LIMIT=200kb

# Générer JWT_SECRET (PowerShell) :
# -join ((48..57 + 65..90 + 97..122) | Get-Random -Count 64 | ForEach-Object { [char]$_ })
