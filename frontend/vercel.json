{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm --prefix ../backend install --omit=dev --no-optional && npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "builds": [
    {
      "src": "api/ping.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/health.js",
      "use": "@vercel/node",
      "config": { "includeFiles": "../backend/utils/**" }
    },
    {
      "src": "api/[...slug].js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 30,
        "includeFiles": "../backend/**",
        "memory": 1024
      }
    },
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 30,
        "includeFiles": "../backend/**",
        "memory": 1024
      }
    }
  ],
  "routes": [
    { "src": "/api/ping", "dest": "/api/ping.js" },
    { "src": "/api/health", "dest": "/api/health.js" },
    { "src": "/uploads/(.*)", "dest": "/api/index.js" },
    { "src": "/api/(.*)", "dest": "/api/[...slug].js" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
