{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm --prefix ../backend install --omit=dev --no-optional && npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "builds": [
    {
      "src": "api/server.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 30,
        "includeFiles": "../backend/**",
        "memory": 1024
      }
    }
  ],
  "routes": [
    { "src": "/api/ping", "dest": "/api-ping.json" },
    { "src": "/api/health", "dest": "/api-health.json" },
    { "src": "/uploads/(.*)", "dest": "/api/server.js" },
    { "src": "/api/(.*)", "dest": "/api/server.js" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
