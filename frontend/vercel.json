{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm --prefix .. run vercel-build",
  "outputDirectory": "dist",
  "installCommand": "echo \"install via vercel-build\"",
  "rewrites": [
    { "source": "/api/health", "destination": "/api/health.js" },
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/api", "destination": "/api/index.js" },
    { "source": "/uploads/(.*)", "destination": "/api/index.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "../backend/**",
      "memory": 1024
    },
    "api/health.js": {
      "includeFiles": "../backend/utils/jwtSecret.js"
    }
  }
}
