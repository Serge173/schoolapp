{
  "installCommand": "npm install --omit=dev",
  "buildCommand": "npm run build",
  "outputDirectory": "admin/dist",
  "functions": {
    "api/programmes-figs.js": {
      "includeFiles": "database/figs-programmes.json"
    },
    "api/filieres.js": {
      "includeFiles": "database/figs-programmes.json"
    },
    "api/universites.js": {
      "includeFiles": "database/figs-programmes.json"
    },
    "api/server.js": {
      "maxDuration": 60
    },
    "api/admin.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/ping", "destination": "/api/ping" },
    { "source": "/api/health", "destination": "/api/health" },
    { "source": "/api/admin/login", "destination": "/api/admin-login" },
    { "source": "/api/admin/me", "destination": "/api/admin-me" },
    { "source": "/api/admin/logout", "destination": "/api/admin-logout" },
    { "source": "/api/admin/stats", "destination": "/api/admin-stats" },
    { "source": "/api/admin/universites", "destination": "/api/admin-universites" },
    { "source": "/api/admin/filieres/tree", "destination": "/api/admin-filieres-tree" },
    { "source": "/api/admin/filieres", "destination": "/api/admin-filieres-list" },
    { "source": "/api/admin/inscriptions", "destination": "/api/admin-inscriptions" },
    { "source": "/api/admin/rendez-vous", "destination": "/api/admin-rendez-vous" },
    { "source": "/api/admin/:path*", "destination": "/api/admin" },
    { "source": "/api/contact", "destination": "/api/contact-post" },
    { "source": "/api/programmes-figs/:id", "destination": "/api/programmes-figs?id=:id" },
    { "source": "/api/programmes-figs", "destination": "/api/programmes-figs" },
    { "source": "/api/filieres/:id/niveaux-disponibles", "destination": "/api/filieres" },
    { "source": "/api/filieres/:id", "destination": "/api/filieres" },
    { "source": "/api/filieres", "destination": "/api/filieres" },
    { "source": "/api/universites/:id", "destination": "/api/universites" },
    { "source": "/api/universites", "destination": "/api/universites" },
    { "source": "/uploads/(.*)", "destination": "/api/server" },
    { "source": "/api/(.*)", "destination": "/api/server" },
    { "source": "/api", "destination": "/api/server" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
