{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "installCommand": "npm --prefix backend install --omit=dev --no-optional && npm --prefix frontend install",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "frontend/dist",
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "frontend/dist" }
    },
    {
      "src": "api/server.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 30,
        "includeFiles": "backend/**",
        "memory": 1024
      }
    }
  ],
  "routes": [
    { "src": "/api/ping", "dest": "/api-ping.json" },
    { "src": "/api/health", "dest": "/api-health.json" },
    { "src": "/uploads/(.*)", "dest": "/api/server.js" },
    { "src": "/api/(.*)", "dest": "/api/server.js" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
