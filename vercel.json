{
  "installCommand": "npm install --omit=dev",
  "buildCommand": "npm run build",
  "outputDirectory": "admin/dist",
  "functions": {
    "api/programmes-figs.js": {
      "includeFiles": "database/figs-programmes.json"
    },
    "api/filieres.js": {
      "includeFiles": "database/figs-programmes.json",
      "maxDuration": 30
    },
    "api/universites.js": {
      "includeFiles": "database/figs-programmes.json",
      "maxDuration": 30
    },
    "api/server.js": {
      "maxDuration": 15
    },
    "api/admin.js": {
      "maxDuration": 30
    },
    "api/fallback.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/api/ping", "destination": "/api/ping" },
    { "source": "/api/health", "destination": "/api/ping" },
    { "source": "/api/admin/:path*", "destination": "/api/admin/:path*" },
    { "source": "/api/contact", "destination": "/api/filieres?__route=contact" },
    { "source": "/api/inscriptions", "destination": "/api/filieres?__route=inscriptions" },
    { "source": "/api/rendez-vous", "destination": "/api/filieres?__route=rendez-vous" },
    { "source": "/api/demandes-orientation", "destination": "/api/filieres?__route=demandes-orientation" },
    { "source": "/api/programmes-figs/:id", "destination": "/api/programmes-figs?id=:id" },
    { "source": "/api/programmes-figs", "destination": "/api/programmes-figs" },
    { "source": "/api/filieres/:id/niveaux-disponibles", "destination": "/api/filieres" },
    { "source": "/api/filieres/:id", "destination": "/api/filieres" },
    { "source": "/api/filieres", "destination": "/api/filieres" },
    { "source": "/api/universites/:id", "destination": "/api/universites" },
    { "source": "/api/universites", "destination": "/api/universites" },
    { "source": "/uploads/(.*)", "destination": "/api/server" },
    { "source": "/api/(.*)", "destination": "/api/fallback" },
    { "source": "/api", "destination": "/api/fallback" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
