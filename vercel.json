{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "installCommand": "npm --prefix backend install --omit=dev --no-optional && npm --prefix frontend install",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/[...slug].js": {
      "maxDuration": 30,
      "includeFiles": "backend/**",
      "memory": 1024
    },
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "backend/**",
      "memory": 1024
    },
    "api/health.js": {
      "includeFiles": "backend/utils/**"
    }
  },
  "rewrites": [
    { "source": "/uploads/(.*)", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
